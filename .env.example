# Creator OS Starter: copy to .env.local and fill in what you use.
# Nothing here is required to BUILD; the dashboard boots with just the "Core" block.

# ── Core (required to run) ────────────────────────────────────────────────
DATABASE_URL=                 # Postgres (Insforge or any Postgres 14+)
APP_PASSWORD=                 # single-user dashboard password
APP_AUTH_SECRET=              # long random string (session cookie signing)

# ── Storage (Insforge S3-style media) ────────────────────────────────────
INSFORGE_API_BASE_URL=        # https://your-project.us-east.insforge.app
INSFORGE_API_KEY=
INSFORGE_CONNECTION_STRING=

# ── Social posting + analytics (Zernio) ───────────────────────────────────
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_WEBHOOK_SECRET=
ZERNIO_FORWARD_URL=

# ── LLM gateway ───────────────────────────────────────────────────────────
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_TEXT_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_THINK=
OLLAMA_TIMEOUT_MS=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=
TYPESAFE_MODEL=

# ── Revenue + web analytics ───────────────────────────────────────────────
REVENUECAT_API_KEY=
REVENUECAT_BASE_URL=
POSTHOG_API_KEY=

# ── Tracked links (/go/<slug>) ────────────────────────────────────────────
APP_STORE_URL=                # where non-"web-" slugs redirect
WEB_APP_URL=                  # where "web-" slugs redirect (with UTM tags)
SHORT_LINK_HOST=              # optional, e.g. go.yourdomain.com -> <host>/<slug>
APPSTORE_PT=                  # optional App Store Connect provider token (install attribution)

# ── Media + data providers (optional) ─────────────────────────────────────
APIFY_TOKEN=
APIFY_API_KEY=
APIFY_IG_TRANSCRIPT_ACTOR=
APIFY_IG_WHISPER_MODEL=
GIPHY_API_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
HEYGEN_VOICE_ID=
FAL_KEY=
FAL_ALLOW=                    # allow-list for fal.ai call sites (see .claude/lib/fal-gate.js)
REPLICATE_API_TOKEN=
PRODUCTHUNT_TOKEN=
GITHUB_TOKEN=
INSTANTLY_API_KEY=
LATE_API_KEY=
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_AGENT_ID=
TREG_TOKEN=
TREG_ORG=
TREG_BASE=
TREG_MAX_COST=

# ── Agent / voice (optional) ──────────────────────────────────────────────
AGENT_TTS_VOICE_ID=
AGENT_TTS_MODEL=
AGENT_ALLOWED_TOOLS=
JEV_TTS_VOICE_ID=
JEV_TTS_MODEL=
CLAUDE_BIN=
CREATOR_OS_API_KEY=
CREATOR_OS_PROFILE_ID=
CREATOR_OS_PROFILE_IDS=
CREATOR_OS_SIBLING_PROFILE_IDS=
CREATOR_OS_SLOT_HOURS_ET=
CREATOR_OS_THUMBNAIL_PERSONA=
COMMENT_CTA_KEYWORD=
COMMENT_CTA_APP_URL=
AI_NEWS_INGEST_SECRET=

# ── Workers + scheduling ──────────────────────────────────────────────────
LOCAL_WORKERS=0               # 1 = run queue drains/watchdogs locally (Railway runs them by default)
# Every scheduled job in src/lib/content/registry.ts is toggled per environment:
#   <PREFIX>_CRON_ENABLED=1
#   <PREFIX>_CRON_HOURS_ET=9,21
